+/// Attempt a native Wayland fallback when arboard cannot read the clipboard.
+///
+/// Nautilus publishes copied files as URI lists rather than image pixels. Some
+/// Wayland clipboard managers also replay only one of the advertised MIME
+/// types, so try image/png and both common Nautilus file-list formats.
+#[cfg(target_os = "linux")]
+fn try_wayland_clipboard_fallback(
+    error: &PasteImageError,
+) -> Result<(Vec<u8>, PastedImageInfo), PasteImageError> {
+    use PasteImageError::ClipboardUnavailable;
+    use PasteImageError::NoImage;
+
+    if std::env::var_os("WAYLAND_DISPLAY").is_none()
+        || !matches!(error, ClipboardUnavailable(_) | NoImage(_))
+    {
+        return Err(error.clone());
+    }
+
+    tracing::debug!("attempting wl-paste clipboard fallback");
+    if let Some(png) = read_wayland_clipboard("image/png")
+        && let Ok(img) = image::load_from_memory_with_format(&png, image::ImageFormat::Png)
+    {
+        tracing::debug!(
+            "wl-paste opened image/png: {}x{}",
+            img.width(),
+            img.height()
+        );
+        return Ok((
+            png,
+            PastedImageInfo {
+                width: img.width(),
+                height: img.height(),
+                encoded_format: EncodedImageFormat::Png,
+            },
+        ));
+    }
+
+    for mime in ["text/uri-list", "x-special/gnome-copied-files"] {
+        let Some(contents) = read_wayland_clipboard(mime) else {
+            continue;
+        };
+        for path in clipboard_file_paths(&contents, mime == "x-special/gnome-copied-files") {
+            let Ok(img) = image::open(&path) else {
+                continue;
+            };
+            tracing::debug!(
+                "wl-paste opened clipboard image file {}: {}x{}",
+                path.display(),
+                img.width(),
+                img.height()
+            );
+            return encode_dynamic_image_as_png(img);
+        }
+    }
+
+    Err(error.clone())
+}
+
+#[cfg(target_os = "linux")]
+fn read_wayland_clipboard(mime: &str) -> Option<Vec<u8>> {
+    let output = Command::new("@wl-paste@")
+        .args(["--type", mime])
+        .output()
+        .ok()?;
+    if !output.status.success() || output.stdout.is_empty() {
+        return None;
+    }
+    Some(output.stdout)
+}
+
+#[cfg(target_os = "linux")]
+fn clipboard_file_paths(contents: &[u8], gnome_copied_files: bool) -> Vec<PathBuf> {
+    String::from_utf8_lossy(contents)
+        .lines()
+        .map(str::trim)
+        .enumerate()
+        .filter_map(|(index, line)| {
+            if line.is_empty()
+                || line.starts_with('#')
+                || (gnome_copied_files && index == 0 && matches!(line, "copy" | "cut"))
+            {
+                return None;
+            }
+            normalize_pasted_path(line)
+        })
+        .collect()
+}

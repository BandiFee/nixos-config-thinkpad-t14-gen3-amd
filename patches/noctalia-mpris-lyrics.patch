+  std::optional<std::int64_t> parseLrcTimestamp(std::string_view token) {
+    const auto colon = token.find(':');
+    if (colon == std::string_view::npos || colon == 0 || colon + 1 >= token.size()) {
+      return std::nullopt;
+    }
+
+    std::int64_t minutes = 0;
+    const auto [minutesEnd, minutesError] =
+        std::from_chars(token.data(), token.data() + colon, minutes);
+    if (minutesError != std::errc{} || minutesEnd != token.data() + colon || minutes < 0) {
+      return std::nullopt;
+    }
+
+    const std::string_view secondsToken = token.substr(colon + 1);
+    const auto dot = secondsToken.find('.');
+    const std::string_view wholeSecondsToken = secondsToken.substr(0, dot);
+    if (wholeSecondsToken.empty()) {
+      return std::nullopt;
+    }
+
+    std::int64_t seconds = 0;
+    const auto [secondsEnd, secondsError] = std::from_chars(
+        wholeSecondsToken.data(), wholeSecondsToken.data() + wholeSecondsToken.size(), seconds
+    );
+    if (secondsError != std::errc{}
+        || secondsEnd != wholeSecondsToken.data() + wholeSecondsToken.size()
+        || seconds < 0
+        || seconds >= 60) {
+      return std::nullopt;
+    }
+
+    std::int64_t fractionUs = 0;
+    if (dot != std::string_view::npos) {
+      const std::string_view fraction = secondsToken.substr(dot + 1);
+      if (fraction.empty()) {
+        return std::nullopt;
+      }
+      std::int64_t parsedFraction = 0;
+      const auto digits = std::min<std::size_t>(fraction.size(), 6);
+      const auto [fractionEnd, fractionError] =
+          std::from_chars(fraction.data(), fraction.data() + digits, parsedFraction);
+      if (fractionError != std::errc{} || fractionEnd != fraction.data() + digits) {
+        return std::nullopt;
+      }
+      if (!std::ranges::all_of(fraction.substr(digits), [](unsigned char ch) { return std::isdigit(ch) != 0; })) {
+        return std::nullopt;
+      }
+      for (std::size_t i = digits; i < 6; ++i) {
+        parsedFraction *= 10;
+      }
+      fractionUs = parsedFraction;
+    }
+
+    constexpr std::int64_t kMinuteUs = 60'000'000;
+    if (minutes > (std::numeric_limits<std::int64_t>::max() - seconds * 1'000'000 - fractionUs) / kMinuteUs) {
+      return std::nullopt;
+    }
+    return minutes * kMinuteUs + seconds * 1'000'000 + fractionUs;
+  }
+
+  ParsedLyrics parseLyrics(std::string lyrics) {
+    ParsedLyrics parsed{.source = std::move(lyrics)};
+    std::size_t lineStart = 0;
+    while (lineStart <= parsed.source.size()) {
+      const auto lineEnd = parsed.source.find('\n', lineStart);
+      std::string_view line = lineEnd == std::string::npos
+          ? std::string_view(parsed.source).substr(lineStart)
+          : std::string_view(parsed.source).substr(lineStart, lineEnd - lineStart);
+      line = StringUtils::trimRightView(line);
+
+      std::vector<std::int64_t> timestamps;
+      std::size_t textStart = 0;
+      while (textStart < line.size() && line[textStart] == '[') {
+        const auto close = line.find(']', textStart + 1);
+        if (close == std::string_view::npos) {
+          break;
+        }
+        if (const auto timestamp = parseLrcTimestamp(line.substr(textStart + 1, close - textStart - 1));
+            timestamp.has_value()) {
+          timestamps.push_back(*timestamp);
+        }
+        textStart = close + 1;
+      }
+
+      const std::string text = StringUtils::trim(line.substr(textStart));
+      if (!timestamps.empty()) {
+        for (const auto timestamp : timestamps) {
+          parsed.lines.push_back({.positionUs = timestamp, .text = text});
+        }
+      } else if (timestamps.empty() && !text.empty() && textStart == 0 && parsed.untimedText.empty()) {
+        parsed.untimedText = text;
+      }
+
+      if (lineEnd == std::string::npos) {
+        break;
+      }
+      lineStart = lineEnd + 1;
+    }
+
+    std::ranges::stable_sort(parsed.lines, {}, &TimedLyricLine::positionUs);
+    std::vector<TimedLyricLine> merged;
+    merged.reserve(parsed.lines.size());
+    for (auto& line : parsed.lines) {
+      if (!merged.empty() && merged.back().positionUs == line.positionUs) {
+        if (merged.back().text.empty()) {
+          merged.back().text = std::move(line.text);
+        } else if (!line.text.empty() && merged.back().text != line.text) {
+          merged.back().text += " / ";
+          merged.back().text += line.text;
+        }
+      } else {
+        merged.push_back(std::move(line));
+      }
+    }
+    parsed.lines = std::move(merged);
+    return parsed;
+  }
+

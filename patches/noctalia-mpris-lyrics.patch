+MprisLyricWindow lyricWindowAt(const MprisPlayerInfo& player, std::int64_t positionUs) {
+  static thread_local ParsedLyrics cache;
+  if (cache.source != player.lyrics) {
+    cache = parseLyrics(player.lyrics);
+  }
+
+  if (cache.lines.empty()) {
+    return {.current = cache.untimedText};
+  }
+
+  const auto currentEnd = std::ranges::upper_bound(cache.lines, positionUs, {}, &TimedLyricLine::positionUs);
+  if (currentEnd == cache.lines.begin()) {
+    return {.next = currentEnd->text};
+  }
+
+  const auto current = std::prev(currentEnd);
+  MprisLyricWindow window{.current = current->text};
+  if (current != cache.lines.begin()) {
+    window.previous = std::prev(current)->text;
+  }
+  if (currentEnd != cache.lines.end()) {
+    window.next = currentEnd->text;
+  }
+  return window;
+}

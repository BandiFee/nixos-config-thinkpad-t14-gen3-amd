@@ -1246,0 +1248,42 @@ namespace {
+    // Media text is elastic: let it consume the lane space left after every
+    // sibling has kept its natural size. A second layout pass gives its label
+    // the real width budget, so long titles/lyrics scroll inside the widget
+    // instead of being clipped by the section slot or displacing controls.
+    if (!isVertical) {
+      const float centerLaneGap =
+          instance.centerWidgets.empty() ? 0.0F : static_cast<float>(instance.barConfig.widgetSpacing);
+      auto fitMediaToLane = [&](Flex* section, std::vector<std::unique_ptr<Widget>>& widgets,
+                                std::vector<BarCapsuleRun>& capsuleRuns, float slotMain, FlexJustify justify) {
+        auto mediaIt = std::ranges::find_if(widgets, [](const auto& widget) {
+          return dynamic_cast<MediaWidget*>(widget.get()) != nullptr;
+        });
+        if (mediaIt == widgets.end()) {
+          return;
+        }
+
+        auto* media = static_cast<MediaWidget*>(mediaIt->get());
+        Node* mediaBounds = media->layoutBoundsNode();
+        Node* mediaContent = media->outerNode();
+        if (mediaBounds == nullptr || mediaContent == nullptr) {
+          return;
+        }
+
+        const float sectionNatural = section->width();
+        const float mediaOuter = mediaBounds->width();
+        const float nonMedia = std::max(0.0F, sectionNatural - mediaOuter);
+        const float capsuleOverhead = std::max(0.0F, mediaOuter - mediaContent->width());
+        const float contentBudget = std::max(0.0F, slotMain - centerLaneGap - nonMedia - capsuleOverhead);
+        media->setAvailableLength(contentBudget);
+        media->layout(renderer, barAreaW, barAreaH);
+        finalizeCapsules(capsuleRuns);
+        configureSection(section, justify);
+      };
+
+      fitMediaToLane(
+          instance.startSection, instance.startWidgets, instance.startCapsuleRuns, startSlotMain, FlexJustify::Start
+      );
+      fitMediaToLane(
+          instance.endSection, instance.endWidgets, instance.endCapsuleRuns, endSlotMain, FlexJustify::End
+      );
+    }
+

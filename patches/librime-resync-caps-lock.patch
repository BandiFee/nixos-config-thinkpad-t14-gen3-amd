+static bool physical_caps_lock_is_off() {
+  glob_t paths = {};
+  if (glob("/sys/class/leds/*::capslock/brightness", GLOB_NOSORT, NULL,
+           &paths) != 0) {
+    return false;
+  }
+  bool found = false;
+  bool caps_on = false;
+  for (size_t i = 0; i < paths.gl_pathc; ++i) {
+    std::ifstream brightness(paths.gl_pathv[i]);
+    int value = 0;
+    if (brightness >> value) {
+      found = true;
+      caps_on = caps_on || value != 0;
+    }
+  }
+  globfree(&paths);
+  return found && !caps_on;
+}

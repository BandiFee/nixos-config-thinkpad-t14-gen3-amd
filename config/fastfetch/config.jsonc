{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 13,
    "height": 17,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "light_cyan",
      "output": "white"
    },
    "key": {
      "width": 14,
      "type": "both"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "OS",
      "keyIcon": ""
    },
    {
      "type": "host",
      "key": "Host",
      "keyIcon": "󰌢"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyIcon": ""
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyIcon": "󰅐"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyIcon": "󰏖"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "keyIcon": "󰻠"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyIcon": "󰢮"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyIcon": "󰍛"
    },
    {
      "type": "disk",
      "key": "Disk (/)",
      "keyIcon": "󰋊",
      "folders": "/"
    },
    "break",
    {
      "type": "wm",
      "key": "WM",
      "keyIcon": "󰖯"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyIcon": "󰆍"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyIcon": ""
    },
    {
      "type": "localip",
      "key": "Local IP",
      "keyIcon": "󰩟",
      "defaultRouteOnly": false,
      "namePrefix": "wlp2s0"
    },
    "break",
    {
      "type": "colors",
      "key": "Colors",
      "keyIcon": "󰏘",
      "symbol": "circle"
    }
  ]
}
